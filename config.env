# re-lab configuration. Every script sources this file.
# Values here are pins: change them deliberately, then re-run the matching setup step.

# ---------------------------------------------------------------- model server
# auto  : metal on macOS; cuda on Linux when nvidia-smi sees a GPU; otherwise cpu
# metal : macOS. llama-server runs natively on the GPU inside a Seatbelt sandbox,
#         listening on LLAMA_HOST:LLAMA_PORT
# cuda  : Linux + NVIDIA. llama-server runs in a GPU container with --network none,
#         listening only on the Unix socket .run/sock/llama.sock
# cpu   : same container as cuda, without a GPU (slow, but useful for testing)
LLAMA_BACKEND="auto"

# llama.cpp is built from source at this tag; the commit hash is verified after checkout.
LLAMA_CPP_TAG="b11600"
LLAMA_CPP_COMMIT="ace20f679e30a39c09a7b17bec14199855469633"

LLAMA_HOST="127.0.0.1"          # metal only. Never change this to 0.0.0.0
LLAMA_PORT="8080"               # metal only
LLAMA_CTX="32768"               # Qwen3-Coder-30B supports long context; 32K keeps the KV cache small
LLAMA_EXTRA_ARGS=""             # e.g. "--threads 8"

# Chat template (a file under templates/).
#   ""                      : use the template embedded in the GGUF (Qwen models embed theirs).
#   templates/llama3.jinja  : for Daredevil / other Llama-3 GGUFs, which embed none (else llama-server
#                             falls back to ChatML, which Llama 3 doesn't understand).
# Confirm which applies with: make model-info
LLAMA_CHAT_TEMPLATE=""

# cuda/cpu container settings
LLAMA_IMAGE="re-lab/llama-server:${LLAMA_CPP_TAG}"   # the backend name is appended: ...-cuda / ...-cpu
CUDA_VERSION="12.8.1"           # base image nvidia/cuda:<this>-*-ubuntu24.04; needs driver >= 570
CUDA_ARCHS="75;80;86;89;90;120" # compute capabilities to build; "89" alone = RTX 40xx, much faster build
LLAMA_GPUS="all"                # passed to docker --gpus, e.g. "device=0"

# Model. get-model.sh picks the first quant in MODEL_QUANTS that the repo has.
# Abliterated Qwen3-Coder-30B-A3B (huihui-ai's abliteration, mradermacher's imatrix GGUFs).
# Sized for a 48 GB M3 Max: i1-Q4_K_M is ~18.6 GB, leaving room for the Ghidra container and macOS.
# Q5_K_M (~21.7 GB) fits too if you trim the Docker VM; the fallback below grabs it if Q4 is absent.
# Previous default was mlabonne/Daredevil-8B-abliterated-GGUF with MODEL_QUANTS="Q8_0 Q6_K Q5_K_M Q4_K_M".
MODEL_REPO="mradermacher/Huihui-Qwen3-Coder-30B-A3B-Instruct-abliterated-i1-GGUF"
MODEL_REVISION="main"           # get-model.sh resolves this to a commit and records it in models/MODEL.lock
MODEL_QUANTS="Q4_K_M Q5_K_M"    # first match wins; make model prints and pins the exact file + size

# ---------------------------------------------------------------- ghidra container
GHIDRA_VERSION="12.1.4"
GHIDRA_DATE="20260921"
GHIDRA_SHA256="ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db"
PYGHIDRA_MCP_VERSION="0.2.7"
GHIDRA_IMAGE="re-lab/ghidra-mcp:${GHIDRA_VERSION}-${PYGHIDRA_MCP_VERSION}"

GHIDRA_MEM="12g"                # container memory cap (Docker Desktop VM must have at least this)
GHIDRA_HEAP="8g"                # JVM heap inside the container
GHIDRA_CPUS="8"
GHIDRA_PROJECT="lab"            # Ghidra project name under ./projects

# "off"   : no PDB lookups (default; also stops pyghidra-mcp from configuring Microsoft's symbol server)
# "local" : use PDBs you place in ./symbols (mounted read-write: Ghidra keeps its symbol-store index there)
GHIDRA_SYMBOLS="off"

# ---------------------------------------------------------------- agent
AGENT_TOOL_MODE="json"          # json = grammar-constrained steps (works with any model); native = OpenAI tool calls
AGENT_MAX_STEPS="20"
AGENT_MAX_RESULT_CHARS="6000"   # per tool result shown to the model (full results always go to logs/)
AGENT_MAX_TOKENS="2048"         # longest single model reply (raise for deeper explanations)
AGENT_TEMPERATURE="0.2"
